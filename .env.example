# Live mode: Claude drives Surgeon / Breaker / twin vaccines. Leave empty for offline playbook mode.
ANTHROPIC_API_KEY=
TRACEZERO_MODE=auto              # auto | live | demo
TRACEZERO_MODEL=claude-opus-5-5
TRACEZERO_PACE=1.0               # theatrical delay multiplier (0 = instant)
TRACEZERO_BASELINE_MTTR_MIN=45   # manual on-call baseline used for "MTTR saved"
TRACEZERO_AUTODEPLOY=0           # 1 = skip the human approval click

# Real pull requests (otherwise the PR modal is simulated)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_PATH_PREFIX=
